// Windows resources: the program icon and the version shown in the file's Properties.
// Configured by CMake from VERSION.
#include <winver.h>

// IDI_APPLICATION (32512): the webview library loads this id for the window icon.
32512 ICON "@GC_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @GC_VERSION_MAJOR@,@GC_VERSION_MINOR@,@GC_VERSION_PATCH@,0
PRODUCTVERSION  @GC_VERSION_MAJOR@,@GC_VERSION_MINOR@,@GC_VERSION_PATCH@,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "GlossCode"
            VALUE "FileDescription",  "GlossCode G-code editor"
            VALUE "FileVersion",      "@GC_VERSION@"
            VALUE "InternalName",     "GlossCode"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "GlossCode.exe"
            VALUE "ProductName",      "GlossCode"
            VALUE "ProductVersion",   "@GC_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// CREATEPROCESS_MANIFEST_RESOURCE_ID (1), RT_MANIFEST (24)
1 24 "@GC_MANIFEST@"
