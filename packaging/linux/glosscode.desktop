[Desktop Entry]
Type=Application
Name=GlossCode
GenericName=G-code Editor
Comment=Edit CNC G-code with a plain-English line above every line of code
Exec=glosscode %f
Icon=glosscode
Terminal=false
Categories=Development;Engineering;
Keywords=G-code;CNC;NC;Haas;Fanuc;Okuma;mill;lathe;
MimeType=text/x.gcode;text/plain;
StartupWMClass=glosscode
StartupNotify=true
