# Copies the UI page, leaving out the sample programs and example library entries: everything between
# "/* samples */" and "/* end samples */" becomes null. The samples are a separate download
# (docs/releasing.md); the mockup in a browser keeps them.
# cmake -DIN=<docs/mockup/index.html> -DOUT=<file> -P strip-samples.cmake
cmake_minimum_required(VERSION 3.21)

file(READ "${IN}" text)
set(begin_mark "/* samples */")
set(end_mark "/* end samples */")
string(LENGTH "${end_mark}" end_len)
set(out "")
set(count 0)
while(TRUE)
    string(FIND "${text}" "${begin_mark}" b)
    if(b EQUAL -1)
        break()
    endif()
    string(FIND "${text}" "${end_mark}" e)
    if(e LESS b)
        message(FATAL_ERROR "${IN}: \"${begin_mark}\" without a matching \"${end_mark}\"")
    endif()
    string(SUBSTRING "${text}" 0 ${b} head)
    math(EXPR rest "${e} + ${end_len}")
    string(SUBSTRING "${text}" ${rest} -1 text)
    string(APPEND out "${head}null")
    math(EXPR count "${count} + 1")
endwhile()
string(APPEND out "${text}")
if(count EQUAL 0)
    message(FATAL_ERROR "${IN}: no sample markers found")
endif()
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
    if(old STREQUAL out)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${out}")
