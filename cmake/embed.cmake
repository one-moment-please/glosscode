# Writes a C file holding the given files as byte arrays (see src/app/resources.h).
# cmake -DOUT=<file.c> -DVERSION_FILE=<VERSION> -DFILES="name=path|name=path" -P embed.cmake
cmake_minimum_required(VERSION 3.21)

file(READ "${VERSION_FILE}" version)
string(STRIP "${version}" version)
set(c "/* Generated by cmake/embed.cmake. Don't edit. */\n#include <string.h>\n#include \"resources.h\"\n\n")
string(APPEND c "const char GC_VERSION[] = \"${version}\";\n\n")
set(table "")
set(i 0)
string(REPLACE "|" ";" FILES "${FILES}")
foreach(entry IN LISTS FILES)
    string(FIND "${entry}" "=" eq)
    string(SUBSTRING "${entry}" 0 ${eq} name)
    math(EXPR start "${eq} + 1")
    string(SUBSTRING "${entry}" ${start} -1 path)
    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" hexlen)
    math(EXPR len "${hexlen} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    # Break the array into lines of 32 bytes so compilers and diffs stay happy.
    string(REGEX REPLACE "((0x..,){32})" "\\1\n" bytes "${bytes}")
    string(APPEND c "static const unsigned char res_${i}[] = {\n${bytes}0x00};\n")
    string(APPEND table "    { \"${name}\", res_${i}, ${len} },\n")
    math(EXPR i "${i} + 1")
endforeach()
string(APPEND c "\nconst gc_resource gc_resources[] = {\n${table}};\n")
string(APPEND c "const size_t gc_resource_count = ${i};\n\n")
string(APPEND c "const gc_resource *gc_find_resource(const char *name)\n{\n")
string(APPEND c "    for (size_t i = 0; i < gc_resource_count; i++)\n        if (strcmp(gc_resources[i].name, name) == 0) return &gc_resources[i];\n")
string(APPEND c "    return NULL;\n}\n")
# Only touch the output when it changes, so an unchanged UI doesn't relink the program.
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
    if(old STREQUAL c)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${c}")
